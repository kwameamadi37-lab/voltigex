APP_NAME=Voltigex
APP_ENV=local
APP_KEY=base64:wnwGrofz7sRV637PTx0szm0EVTl5NAboNnJs1MNEJUg=
APP_DEBUG=true
# APP_URL= http://localhost:8000
APP_URL= http://192.168.1.76:8000

# Favicon
APP_FAVICON=/assets/bank/images/favicon.png

# Meta Tags
APP_DESCRIPTION="Solutions bancaires innovantes pour particuliers et professionnels"
APP_KEYWORDS="bancaire, innovation, particuliers, professionnels"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voltigex
DB_USERNAME=root
DB_PASSWORD=motdepasse

BROADCAST_DRIVER=pusher


CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

FIREBASE_CREDENTIALS=storage/app/firebase-service-account.json

SESSION_DRIVER=cookie
# Ne pas fixer SESSION_DOMAIN en local pour laisser Laravel utiliser l'hôte courant
# SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000,127.0.0.1,localhost
SESSION_SECURE_COOKIE=false


MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

