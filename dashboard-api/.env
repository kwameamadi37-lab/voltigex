AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=2140824
PUSHER_APP_KEY=490845ff695998f3de67
PUSHER_APP_SECRET=663d449e3a300daec208
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
# Doit être le même cluster que sur dashboard.pusher.com → Channels → votre app → Cluster (ex. eu, mt1).
